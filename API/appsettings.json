    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Overrides": {
                "Microsoft": "Warning",
                "Microsoft.Hosting.Lifetime": "Warning"
            }
        },
        "Using": [
            "Serilog.Sinks.Console",
            "Serilog.Sinks.File"
        ],
        "WriteTo": [
            {
                "Name": "Console"
            },
            {
                "Name": "File",
                "Args": {
                    "path": "./Error/log.txt",
                    "rollingInterval": "Day",
                    "fileSizeLimitBytes": "1000000",
                    "retainedFileCountLimit": 100,
                    "rollOnFileSizeLimit": true,
                    "shared": true,
